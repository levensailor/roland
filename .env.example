APP_NAME=Roland TM-2 Sample Loader
APP_AUTHOR=levensailor
HOST=0.0.0.0
PORT=8080
LOG_DIR=logs
LOG_FILE_NAME=tm2_loader.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3
LOG_TIMEZONE=America/New_York
SDCARD_PATH=
WAVE_ROOT=Roland/TM-2/WAVE
SAMPLE_RATE=44100
BIT_DEPTH=16
DEFAULT_CHANNELS=stereo
MAX_FILES_PER_FOLDER=300
MAX_FOLDERS=300
MAX_UPLOAD_MB=200
MAX_FILENAME_LENGTH=32
FFMPEG_BINARY=ffmpeg
DEFAULT_FOLDERS=Kicks,Snares,Toms,Hats,Cymbals,Perc,FX,Loops,Tracks
ALLOWED_EXTENSIONS=.wav,.mp3,.aiff,.aif,.flac,.m4a,.aac,.ogg,.oga,.caf,.wma,.mp4
CORS_ORIGINS=*
